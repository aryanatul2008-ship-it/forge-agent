{
  "name": "forge-agent",
  "displayName": "Forge Agent",
  "description": "VS Code coding agent client powered by TrueForge",
  "version": "0.1.0",
  "publisher": "forge-agent",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onView:forgeAgent.chatView",
    "onCommand:forgeAgent.openPanel",
    "onCommand:tfAgent.openPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forgeAgent.openPanel",
        "title": "TF Agent: Open Panel",
        "category": "TF Agent"
      },
      {
        "command": "forgeAgent.openChat",
        "title": "Forge Agent: Open Chat",
        "category": "Forge Agent"
      },
      {
        "command": "forgeAgent.cancelTurn",
        "title": "Forge Agent: Cancel Turn",
        "category": "Forge Agent"
      },
      {
        "command": "forgeAgent.undoLastChange",
        "title": "TF Agent: Undo Last Applied Change",
        "category": "TF Agent"
      },
      {
        "command": "tfAgent.undoLastChange",
        "title": "TF Agent: Undo Last Applied Change",
        "category": "TF Agent"
      },
      {
        "command": "forgeAgent.inlineEdit",
        "title": "TF Agent: Inline Edit",
        "category": "TF Agent"
      },
      {
        "command": "tfAgent.inlineEdit",
        "title": "TF Agent: Inline Edit",
        "category": "TF Agent"
      }
    ],
    "keybindings": [
      {
        "command": "forgeAgent.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge-agent-sidebar",
          "title": "Forge Agent",
          "icon": "$(copilot)"
        }
      ]
    },
    "views": {
      "forge-agent-sidebar": [
        {
          "type": "webview",
          "id": "forgeAgent.chatView",
          "name": "Agent Chat"
        }
      ]
    },
    "configuration": {
      "title": "Forge Agent",
      "properties": {
        "forgeAgent.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "URL of the local TrueForge agent server"
        },
        "forgeAgent.mcpPort": {
          "type": "number",
          "default": 8795,
          "description": "Default port for the local MCP server (falls back to ephemeral port if busy)"
        },
        "forgeAgent.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "google-gemini/gemini-3-1-flash-lite",
            "google-gemini/gemini-3-5-flash-lite"
          ],
          "description": "Ordered list of model FQNs: primary model is listed first, followed by fallback models automatically used if primary fails."
        },
        "forgeAgent.primaryModel": {
          "type": "string",
          "default": "google-gemini/gemini-3-1-flash-lite",
          "description": "Primary model FQN configured in TrueForge (e.g. 'google-gemini/gemini-3-1-flash-lite')"
        },
        "forgeAgent.fallbackModel": {
          "type": "string",
          "default": "google-gemini/gemini-3-5-flash-lite",
          "description": "Fallback model FQN automatically used when the primary model fails or times out (e.g. 'google-gemini/gemini-3-5-flash-lite')"
        },
        "forgeAgent.contextBudgetTokens": {
          "type": "number",
          "default": 6000,
          "description": "Token budget cap for injected workspace context and retrieved snippets"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "register-agent": "esbuild scripts/register-agent.ts --bundle --platform=node --outfile=dist/register-agent.js && node dist/register-agent.js",
    "smoke-test": "esbuild scripts/smoke-test.ts --bundle --platform=node --outfile=dist/smoke-test.js && node dist/smoke-test.js",
    "test": "esbuild scripts/test-review.ts --bundle --platform=node --external:vscode --outfile=dist/test-review.js && node dist/test-review.js",
    "test:task-a": "esbuild scripts/test-task-a.ts --bundle --platform=node --external:vscode --outfile=dist/test-task-a.js && node dist/test-task-a.js",
    "test:task-b": "esbuild scripts/test-task-b.ts --bundle --platform=node --external:vscode --outfile=dist/test-task-b.js && node dist/test-task-b.js",
    "test:context": "esbuild scripts/test-context.ts --bundle --platform=node --external:vscode --outfile=dist/test-context.js && node dist/test-context.js",
    "test:resilience": "esbuild scripts/test-resilience.ts --bundle --platform=node --external:vscode --outfile=dist/test-resilience.js && node dist/test-resilience.js",
    "test:audit": "esbuild scripts/test-audit.ts --bundle --platform=node --external:vscode --outfile=dist/test-audit.js && node dist/test-audit.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@truefoundry/trueforge-sdk": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
